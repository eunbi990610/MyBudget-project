<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mybudget.mapper.PaymentMethodMapper">

<!--지출수단 추가 -->
    <insert id="insertPayment" useGeneratedKeys="true">
        insert into TBL_PAYMENT_METHOD(user_id, payment_method_name)
        values (#{userId}, #{paymentMethodName})
    </insert>

<!--지출 수단 리스트 조회-->
    <select id="selectAllPayment">
        select payment_method_id, user_id, payment_method_name, create_at
        from TBL_PAYMENT_METHOD
        where USER_ID = #{userId}
        order by PAYMENT_METHOD_NAME
    </select>




</mapper>